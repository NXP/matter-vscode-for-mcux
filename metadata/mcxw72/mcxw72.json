{
    "name": "mcxw72",
    "description": "Metadata for mcxw72 support in Matter",
    "sdkVersion": "3.0",
    "sdkWestManifest": "third_party/nxp/nxp_matter_support/github_sdk/sdk_next/manifest/west.yml",
    "sdkEnvironmentVariable": "NXP_SDK_ROOT",
    "boards": [
        {
            "name": "FRDM-MCXW72",
            "description": "MCX W72x Secure and Ultra-Low-Power MCUs for Matter, Thread, Zigbee and Bluetooth LE",
            "image": "images/frdm-mcxw72.png",
            "url": "https://www.nxp.com/products/MCX-W72X",
            "probeTarget": {
                "LinkServer": "MCXW727C:FRDM-MCXW72",
                "SEGGER": "MCXW72"
            },
            "userVisible": true
        },
        {
            "name": "MCXW72EVK",
            "description": "MCX W72x Secure and Ultra-Low-Power MCUs for Matter, Thread, Zigbee and Bluetooth LE",
            "image": "images/mcxw72evk.png",
            "url": "https://www.nxp.com/products/MCX-W72X",
            "probeTarget": {
                "LinkServer": "MCXW727C:MCX-W72-EVK",
                "SEGGER": "MCXW72"
            },
            "userVisible": true
        }
    ],
    "apps": [
        {
            "name": "lighting-app",
            "deviceType": "On/Off Light",
            "targets": {
                "nxp-mcxw72-freertos-lighting": "Lighting app",
                "nxp-mcxw72-freertos-lighting-factory": "Lighting app with factory data",
                "nxp-mcxw72-freertos-lighting-rotating-id": "Lighting app with rotating device id",
                "nxp-mcxw72-freertos-lighting-sw-v2": "Lighting app (OTA)",
                "nxp-mcxw72-freertos-lighting-factory-sw-v2": "Lighting app with factory data (OTA)",
            }
        },
        {
            "name": "contact-sensor-app",
            "deviceType": "Contact Sensor",
            "targets": {
                "nxp-mcxw72-freertos-contact-sensor-low-power": "Low power contact sensor app",
                "nxp-mcxw72-freertos-contact-sensor-low-power-factory": "Low power contact sensor app with factory data",
                "nxp-mcxw72-freertos-contact-sensor-low-power-lit": "Low power contact sensor app (LIT)",
                "nxp-mcxw72-freertos-contact-sensor-low-power-sw-v2": "Low power contact sensor app (OTA)",
                "nxp-mcxw72-freertos-contact-sensor-low-power-factory-sw-v2": "Low power contact sensor app with factory data (OTA)"
            }
        }
    ],
    "debugConfig": {
        "loadAddress": "0",
        "probes": {
            "LinkServer": {
                "interface": "swd",
                "initCommands": []
            },
            "SEGGER": {
                "interface": "swd",
                "speed": "4000",
                "initCommands": []
            }
        },
        "preFlashActions": [
            {
                "description": "Run pre flash actions (load NBU, load factory data)",
                "command": "scripts/flash_utils.py --platform mcxw72"
            }
        ]
    }
}